{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": [
		"src/index.ts",
		"src/testing/index.ts",
		"src/presentation/http/problem-details.ts",
		"src/presentation/errors/index.ts",
		"src/domain/state-machine/index.ts",
		"src/domain/value-object/money/index.ts"
	],
	"sortEntryPoints": false,
	"out": "docs/api",
	"plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
	"readme": "none",
	"useCodeBlocks": true,
	"expandObjects": true,
	"sort": ["source-order"],
	"excludeInternal": true,
	"docsRoot": "docs",
	"sidebar": {
		"autoConfiguration": true,
		"format": "vitepress",
		"pretty": true,
		"collapsed": false
	},
	"intentionallyNotExported": [
		"IValueObject",
		"RepositoryFacadeOf",
		"RepositoryWiringViolation",
		"UntypedMapDispatch"
	],
	"validation": {
		"notExported": true,
		"invalidLink": true
	},
	"treatValidationWarningsAsErrors": true
}
