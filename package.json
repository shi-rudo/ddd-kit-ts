{
	"name": "@shirudo/ddd-kit",
	"version": "3.0.0-rc.4",
	"packageManager": "pnpm@11.13.1",
	"description": "Composable TypeScript toolkit for tactical DDD",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shi-rudo/ddd-kit-ts.git"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./http": {
			"types": "./dist/http.d.ts",
			"import": "./dist/http.js"
		},
		"./public-errors": {
			"types": "./dist/public-errors.d.ts",
			"import": "./dist/public-errors.js"
		},
		"./money": {
			"types": "./dist/money.d.ts",
			"import": "./dist/money.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vp pack",
		"test": "vp test",
		"test:coverage": "vp test --coverage --coverage.include='src/**'",
		"test:edge-runtime": "pnpm build && node scripts/run-edge-runtime-smoke.mjs",
		"audit:prod": "pnpm audit --prod",
		"benchmark:aggregate-hot-path": "pnpm build && node --expose-gc benchmarks/aggregate-hot-path.mjs",
		"benchmark:event-stamping": "pnpm build && node --expose-gc benchmarks/domain-event-stamping.mjs",
		"clean": "rm -rf dist",
		"lint": "biome check .",
		"format": "pnpm exec biome format --write . && pnpm exec biome lint --write . && pnpm exec biome check --write .",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"prepublishOnly": "npm run clean && npm run typecheck && npm run lint && vp test && npm run build && node scripts/run-edge-runtime-smoke.mjs",
		"docs:api": "typedoc",
		"docs:dev": "typedoc && vitepress dev docs",
		"docs:build": "typedoc && vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"mutate:aggregate": "stryker run stryker.aggregate.json",
		"mutate:money": "stryker run stryker.money.json"
	},
	"keywords": [
		"ddd",
		"domain",
		"typescript",
		"toolkit"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@shirudo/base-error": "^8.3.0",
		"@shirudo/result": "^1.1.1",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitest/coverage-v8": "catalog:",
		"edge-runtime": "4.0.1",
		"esbuild": "0.28.2",
		"fast-check": "^4.9.0",
		"miniflare": "5.20260820.0-alpha",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typedoc-vitepress-theme": "^1.1.3",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitepress": "2.0.0-alpha.18",
		"vitepress-plugin-llms": "^1.13.5",
		"vitest": "catalog:"
	},
	"private": false,
	"author": "Shirudo",
	"contributors": [
		"Shirudo"
	],
	"homepage": "https://github.com/shi-rudo/ddd-kit-ts#readme",
	"bugs": {
		"url": "https://github.com/shi-rudo/ddd-kit-ts/issues"
	},
	"peerDependencies": {
		"@shirudo/base-error": "^8.0.0",
		"@shirudo/result": "^1.0.0"
	}
}
