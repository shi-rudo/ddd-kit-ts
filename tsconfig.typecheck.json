{
	// Type-checking scope for `npm run typecheck` and CI: the library source
	// PLUS the shipped examples. The build config (tsconfig.json) keeps its
	// src-only scope; examples must never land in dist, but a type break in
	// example code must fail the gate instead of shipping silently.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"rootDir": "."
	},
	"include": ["src", "examples"]
}
